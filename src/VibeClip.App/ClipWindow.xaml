<Window x:Class="VibeClip.App.ClipWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="VibeClip · Ver y recortar" Width="1200" Height="850" MinWidth="1030" MinHeight="740" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><Button Content="← Volver a clips" Click="Back" DockPanel.Dock="Left" Margin="0,0,18,0"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Filename" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="VISOR Y RECORTE LOCAL" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="Black" CornerRadius="10" BorderBrush="#343D4B" BorderThickness="1"><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" MediaOpened="MediaOpened" MediaFailed="MediaFailed" MediaEnded="MediaEnded" Stretch="Uniform"/></Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,12"><StackPanel><Slider x:Name="Seek" Minimum="0" Maximum="1" PreviewMouseLeftButtonUp="SeekReleased"/><DockPanel Margin="0,8,0,0"><Button Content="▶" Click="Play" Padding="14,7"/><Button Content="Ⅱ" Click="Pause" Padding="14,7"/><CheckBox Content="Silenciar reproducción" Checked="Mute" Unchecked="Mute" FontSize="12"/><TextBlock x:Name="PositionLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></DockPanel></StackPanel></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"><StackPanel><DockPanel><Button Content="Restablecer" Click="ResetRange" Padding="10,5" DockPanel.Dock="Right" Margin="0"/><TextBlock Text="Recortar clip" FontSize="17" FontWeight="SemiBold"/></DockPanel><TextBlock x:Name="RangeLabel" Foreground="{StaticResource Accent}" Margin="0,8,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Inicio" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="StartSlider" Maximum="1" ValueChanged="RangeChanged" VerticalAlignment="Center"/><Button Grid.Column="2" Content="Aquí" Click="MarkStart" Padding="10,5" Margin="8,0,0,0"/></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Final" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="EndSlider" Maximum="1" ValueChanged="RangeChanged" VerticalAlignment="Center"/><Button Grid.Column="2" Content="Aquí" Click="MarkEnd" Padding="10,5" Margin="8,0,0,0"/></Grid></StackPanel></Border>
   </Grid>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Audio del clip" Style="{StaticResource Section}"/>
    <ComboBox x:Name="MixMode" SelectionChanged="MixModeChanged"><ComboBoxItem Content="Pista principal"/><ComboBoxItem Content="Mezcla por pistas"/></ComboBox>
    <TextBlock x:Name="AudioStatus" Text="Analizando las pistas grabadas…" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12"/>
    <StackPanel x:Name="TrackRows"/>
    <TextBlock Text="Los ajustes por pista se aplican a la copia exportada. La reproducción usa la pista principal." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/>
    <Border Height="1" Background="#343D4B" Margin="0,24,0,20"/>
    <TextBlock Text="Cómo guardar" Style="{StaticResource Section}"/>
    <ComboBox x:Name="ExportMode" SelectedIndex="0"><ComboBoxItem Content="Rápido · Corte aproximado"/><ComboBoxItem Content="Exacto · Recodifica video"/></ComboBox>
    <TextBlock Text="Rápido conserva el video comprimido y corta cerca de un fotograma clave. Exacto procesa el video y puede consumir más recursos." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,18"/>
    <Border Background="#272238" CornerRadius="8" Padding="12"><TextBlock Text="◇  El original se conserva. Todo se procesa en tu PC." Foreground="#D9C2FC" FontSize="12"/></Border>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,20,0,0"><Button x:Name="ExportButton" Content="Guardar copia" Click="Export" IsEnabled="False" DockPanel.Dock="Right" Background="{StaticResource Accent}" Foreground="#171020" FontWeight="SemiBold" Margin="10,0,0,0"/><Button x:Name="CancelExport" Content="Cancelar exportación" Click="CancelExportClick" Visibility="Collapsed" DockPanel.Dock="Right"/><TextBlock x:Name="Status" Text="El archivo original se conserva." Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/></DockPanel>
 </Grid>
</Window>
