<Window x:Class="VibeClip.App.ClipWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="VibeClip · Visor" Width="1020" Height="730" MinWidth="840" MinHeight="600" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="Filename" FontSize="22" Margin="0,0,0,16"/>
  <Border Grid.Row="1" Background="Black" CornerRadius="8"><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" MediaOpened="MediaOpened" MediaFailed="MediaFailed" MediaEnded="MediaEnded" Stretch="Uniform"/></Border>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><Slider x:Name="Seek" Minimum="0" Maximum="1" PreviewMouseLeftButtonUp="SeekReleased"/><DockPanel><Button Content="▶ Reproducir" Click="Play"/><Button Content="Ⅱ Pausar" Click="Pause"/><CheckBox Content="Silenciar todo" Checked="Mute" Unchecked="Mute"/><TextBlock x:Name="PositionLabel" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></StackPanel>
  <Border Grid.Row="3" Background="#222832" Padding="14" CornerRadius="8" Margin="0,8"><StackPanel><TextBlock Text="Preparar recorte" FontSize="17"/><WrapPanel><Button Content="Marcar inicio aquí" Click="MarkStart"/><Button Content="Marcar final aquí" Click="MarkEnd"/><Button Content="Restablecer" Click="ResetRange"/><TextBlock x:Name="RangeLabel" VerticalAlignment="Center" Margin="8"/></WrapPanel><TextBlock Text="Vista previa del rango. Exportar recortes y mezclar pistas aún está en desarrollo." Foreground="#E6BB76"/></StackPanel></Border>
  <DockPanel Grid.Row="4"><Button Content="Guardar copia · Próximamente" IsEnabled="False" DockPanel.Dock="Right"/><TextBlock x:Name="Status" Text="El archivo original se conserva. Solo se abre para reproducirlo." Foreground="#A9B3C3" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
