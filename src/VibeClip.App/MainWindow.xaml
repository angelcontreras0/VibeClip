<Window x:Class="VibeClip.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="VibeClip" Width="1180" Height="900" MinWidth="1030" MinHeight="760" WindowStartupLocation="CenterScreen">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,24"><Border DockPanel.Dock="Right" Background="#242033" CornerRadius="20" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="●  LOCAL Y PRIVADO" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/></Border><StackPanel Orientation="Horizontal"><TextBlock Text="↶" Foreground="{StaticResource Accent}" FontSize="38" Margin="0,0,12,0"/><StackPanel><TextBlock Text="VibeClip" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Guarda lo que acaba de pasar" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <DockPanel><Button x:Name="CaptureButton" Content="Activar" Click="ToggleCapture" DockPanel.Dock="Right" Margin="8,0,0,0"/><StackPanel><TextBlock x:Name="CaptureTitle" Text="● Captura pausada" FontSize="23" FontWeight="SemiBold" Foreground="#A7B2C5"/><TextBlock x:Name="CaptureStatus" Text="Actívala cuando quieras conservar tus momentos." Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12"/></StackPanel></DockPanel>
    <TextBlock Text="Fuente de captura" Style="{StaticResource Section}" Margin="0,26,0,6"/>
    <Border Background="#252C36" CornerRadius="7" Padding="14"><TextBlock x:Name="CaptureSource" Text="▣  Monitor 1 · Pantalla completa"/></Border>
    <TextBlock Text="Selección de ventana: próxima etapa" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
    <TextBlock Text="Duración del clip" Style="{StaticResource Section}" Margin="0,24,0,6"/>
    <UniformGrid x:Name="Durations" Columns="4"><Button Content="30 s" Tag="30" Click="DurationClick"/><Button Content="60 s" Tag="60" Click="DurationClick"/><Button Content="90 s" Tag="90" Click="DurationClick"/><Button Content="120 s" Tag="120" Click="DurationClick"/></UniformGrid>
    <Button x:Name="SaveClipButton" Content="↶  Guardar últimos 60 segundos" Click="SaveClipClick" IsEnabled="False" Background="{StaticResource Accent}" Foreground="#1A1324" FontWeight="SemiBold" FontSize="16" Margin="0,16,0,12" Padding="12,18"/>
    <TextBlock x:Name="BufferStatus" Text="El búfer comienza al activar la captura." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="12"/>
    <Border Height="1" Background="#343D4B" Margin="0,22,0,18"/>
    <TextBlock Text="Atajo personalizado" Style="{StaticResource Section}"/>
    <DockPanel><Button Content="Cambiar" Click="ChangeShortcut" DockPanel.Dock="Right" Margin="10,0,0,0"/><Border Background="#252C36" BorderBrush="#414958" BorderThickness="1" Padding="12" CornerRadius="7"><TextBlock x:Name="ShortcutLabel" VerticalAlignment="Center"/></Border></DockPanel>
    <TextBlock Text="Captura experimental de video sin audio. El audio por aplicación sigue en desarrollo." Foreground="#D9B77F" FontSize="11" Margin="0,18,0,0"/>
   </StackPanel></ScrollViewer></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><Button Content="Actualizar" Click="RefreshClick" DockPanel.Dock="Right" Padding="10,7" Margin="8,0,0,0"/><TextBlock Text="Clips recientes" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <TextBlock Grid.Row="1" x:Name="CatalogStatus" Text="Guardados en este equipo" Foreground="{StaticResource Muted}" Margin="0,10,0,18" FontSize="12"/>
    <ListBox Grid.Row="2" x:Name="ClipList" Background="Transparent" Foreground="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OpenSelectedClip">
     <ListBox.ItemTemplate><DataTemplate><Border Background="#252C36" CornerRadius="9" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#3A2D50" CornerRadius="6" Height="58" Margin="0,0,14,0"><TextBlock Text="▶" Foreground="{StaticResource Accent}" FontSize="23" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="2" Content="Abrir" Click="OpenCard" Tag="{Binding}" Padding="10,7" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    </ListBox>
    <Button Grid.Row="3" Content="＋ Abrir un clip de mi PC" Click="ImportClip" Margin="0,12,0,0"/>
   </Grid></Border>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,20,0,12" Padding="16,12"><DockPanel><Button Content="Cambiar" Click="ChooseFolder" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button Content="Abrir carpeta" Click="OpenFolder" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBlock Text="▱" FontSize="27" VerticalAlignment="Center" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="GUARDAR EN" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FolderLabel" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel></DockPanel></Border>
  <DockPanel Grid.Row="3"><Button Content="⚙  Configuración" Click="OpenSettings" DockPanel.Dock="Right" Margin="0" Padding="12,7"/><TextBlock x:Name="Footer" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/></DockPanel>
 </Grid>
</Window>
