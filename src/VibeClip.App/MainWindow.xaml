<Window x:Class="VibeClip.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="VibeClip · Desarrollo" Width="1100" Height="740" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,24"><TextBlock Text="↶ VibeClip" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="Tu momento. Tu clip. En tu PC." Foreground="#A9B3C3" Margin="0,5,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="● Captura no disponible" FontSize="24" Foreground="#E6BB76"/>
    <TextBlock Text="El motor de captura está en desarrollo. Esta versión permite configurar la app y abrir clips locales." Foreground="#A9B3C3" Margin="0,8,0,20"/>
    <TextBlock Text="Fuente de captura" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock Text="Pantalla o ventana: pendiente del motor de captura" Foreground="#A9B3C3" Margin="0,8,0,24"/>
    <TextBlock Text="Duración del clip" FontSize="17" FontWeight="SemiBold"/>
    <WrapPanel x:Name="Durations" Margin="0,8,0,0"><Button Content="30 s" Tag="30" Click="DurationClick"/><Button Content="60 s" Tag="60" Click="DurationClick"/><Button Content="90 s" Tag="90" Click="DurationClick"/><Button Content="120 s" Tag="120" Click="DurationClick"/></WrapPanel>
    <Button Content="Guardar clip · Próximamente" IsEnabled="False" Background="{StaticResource Accent}" Foreground="#17131F" Margin="0,16,0,24" Padding="20,16"/>
    <TextBlock Text="Atajo personalizado" FontSize="17" FontWeight="SemiBold"/>
    <DockPanel Margin="0,8,0,0"><Button Content="Cambiar" Click="ChangeShortcut" DockPanel.Dock="Right"/><TextBlock x:Name="ShortcutLabel" VerticalAlignment="Center"/></DockPanel>
   </StackPanel>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel><Button Content="Actualizar" Click="RefreshClick" DockPanel.Dock="Right"/><TextBlock Text="Clips recientes" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <TextBlock Grid.Row="1" x:Name="CatalogStatus" Foreground="#A9B3C3" Margin="0,8,0,12"/>
    <ListBox Grid.Row="2" x:Name="ClipList" Background="Transparent" Foreground="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OpenSelectedClip">
     <ListBox.ItemTemplate><DataTemplate><Border Background="#222832" CornerRadius="8" Padding="14" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" Foreground="#A9B3C3" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
    </ListBox>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,22,0,12"><Button Content="Elegir carpeta" Click="ChooseFolder" DockPanel.Dock="Right"/><Button Content="Abrir carpeta" Click="OpenFolder" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="Guardar en" Foreground="#A9B3C3"/><TextBlock x:Name="FolderLabel" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
  <DockPanel Grid.Row="3"><Button Content="Configuración" Click="OpenSettings" DockPanel.Dock="Right"/><Button Content="Abrir clip…" Click="ImportClip" DockPanel.Dock="Right"/><TextBlock x:Name="Footer" VerticalAlignment="Center" Foreground="#A9B3C3"/></DockPanel>
 </Grid>
</Window>
