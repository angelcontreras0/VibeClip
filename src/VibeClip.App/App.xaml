<Application x:Class="VibeClip.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#B28AF5" />
    <SolidColorBrush x:Key="Muted" Color="#A7B2C5" />
    <Style x:Key="CaptureSwitch" TargetType="Button"><Setter Property="Width" Value="64"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="ToolTip" Value="Activar o detener la captura"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Switch" Background="#434B59" CornerRadius="18"><Ellipse x:Name="Knob" Width="28" Height="28" Fill="White" HorizontalAlignment="Left" Margin="4"/></Border><ControlTemplate.Triggers><Trigger Property="Tag" Value="on"><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Switch" Property="Background" Value="#B28AF5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Switch" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1D232C"/><Setter Property="BorderBrush" Value="#343D4B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style TargetType="Window"><Setter Property="Background" Value="#15191F"/><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#292F39"/><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#414958"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#252B34"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,5,8,8"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,5,8,8"/><Setter Property="Padding" Value="12,10"/><Setter Property="Background" Value="#252C36"/><Setter Property="Foreground" Value="#F2F3F5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#252C36" CornerRadius="7" BorderBrush="#414958" BorderThickness="1"><TextBlock Text="⌄" Foreground="#BEC8D8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
        <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,10,32,10"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="#252C36" BorderBrush="#414958" BorderThickness="1" Padding="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer></Border></Popup>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#4C3C6D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#B7C2D3"/><Setter Property="Padding" Value="24,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8,8,0,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#40305E"/><Setter Property="Foreground" Value="#E2CCFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Application.Resources>
</Application>
